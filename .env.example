# Copy to .env.local and fill in what you need. Every value is optional — the app runs
# with none of them (reports via URL encoding, AI shows its deterministic fallback,
# history disabled). Features light up as you add the matching vars.

# --- Database (Neon Postgres) — enables short links + saved-report history ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Auth (Better Auth, self-hosted) ---
# Generate a secret:  openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth (optional — enables "Continue with Google") ---
# Register this redirect URI in Google Cloud:  <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI narrative (optional) ---
# Production: set GEMINI_API_KEY (free key: https://aistudio.google.com).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Local dev alternative: run Ollama (https://ollama.com) — no key needed.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
